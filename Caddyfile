# Public entry point for the lab server.
# Caddy terminates HTTPS (certificates from Let's Encrypt, renewed automatically)
# and forwards requests to containers on the shared "lab-net" network.

pth.ddomlab.org {
	reverse_proxy pth:5000
}

eln.ddomlab.org {
	reverse_proxy elabftw:443
	log {
		output file /var/log/caddy/eln-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
		}
	}
}

# The old lab-server address. The PTH sensor and MEDUSA still post to /pth/... here;
# everything else is eln_server (scanner page, labels, autofill API).
eln.ddomlab.org:5000 {
	@pth path /pth /pth/*
	handle @pth {
		reverse_proxy pth:5000
	}
	handle {
		reverse_proxy eln-server:5000
	}
	log {
		output file /var/log/caddy/eln-5000-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 2160h
		}
	}
}
